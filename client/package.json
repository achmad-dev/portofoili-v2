      "prettier --write"
    ]
  },
  "dependencies": {
    "@tailwindcss/typography": "0.5.20",
    "@tanstack/react-query": "^5.104.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "1.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "9.0.1",
    "remark-gfm": "4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "25.5.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "autoprefixer": "10.6.1",
    "eslint": "9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "8.5.29",
    "prettier": "^3.9.9",
    "tailwindcss": "3.4.19",
    "typescript": "6.0.2",
    "vite": "8.3.3"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "@humanfs/node": "0.16.8",
    "baseline-browser-mapping": "2.11.27",
    "brace-expansion": "1.1.21",
    "browserslist": "4.29.3",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.20",
    "postcss": "8.5.29",
    "postcss-selector-parser": "7.1.6",
    "source-map-js": "1.2.2"
