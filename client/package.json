{
  "name": "achmadalfazari",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "sync:blog": "python3 ../scripts/sync_medium.py",
    "predev": "npm run sync:blog",
    "dev": "vite",
    "prebuild": "npm run sync:blog",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "prepare": "husky",
